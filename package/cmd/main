#!/bin/bash
# RUIJIE 后端启动脚本
set -u

APP_HOME="/var/apps/ruijie"
SERVER_DIR="/usr/local/apps/@appcenter/ruijie/server"
APP_BIN="$SERVER_DIR/ruijie_service"
RUN_DIR="$APP_HOME/var"
SOCKET_PATH="$APP_HOME/target/ruijie"

export TRIM_APPDEST="$APP_HOME"
export RUIJIE_HTTP_SOCKET_PATH="$SOCKET_PATH"
export RUIJIE_PROBE_PORT="55557"

mkdir -p "$APP_HOME/target" "$RUN_DIR" 2>/dev/null || true
LOG_FILE="$RUN_DIR/ruijie.log"

is_running() {
  [ -x "$APP_BIN" ] && "$APP_BIN" --status >/dev/null 2>&1
  return $?
}

kill_instance() {
  pkill -TERM -f "^$APP_BIN" 2>/dev/null || true
  for i in {1..10}; do
    pgrep -f "^$APP_BIN" >/dev/null 2>&1 || break
    sleep 0.2
  done
  pkill -9 -f "^$APP_BIN" 2>/dev/null || true
  rm -f /tmp/ruijie.pid 2>/dev/null || true
}

start_app() {
  # Windows 上打的包可能丢失可执行位，启动前补一次
  [ -f "$APP_BIN" ] && chmod +x "$APP_BIN" 2>/dev/null || true
  echo "$(date) [INFO] 正在尝试启动后端..." >> "$LOG_FILE"
  if is_running; then
    if [ -S "$SOCKET_PATH" ]; then
      exit 0
    fi
    kill_instance
    sleep 0.5
  fi
  if [ ! -x "$APP_BIN" ]; then
    echo "$(date) [ERROR] 找不到执行文件: $APP_BIN" >> "$LOG_FILE"
    exit 1
  fi
  rm -f "$SOCKET_PATH" /tmp/ruijie.pid 2>/dev/null || true
  cd "$SERVER_DIR" || exit 1
  "$APP_BIN" --daemon >>"$LOG_FILE" 2>&1
  for i in {1..75}; do
    if [ -S "$SOCKET_PATH" ]; then
      exit 0
    fi
    sleep 0.2
  done
  echo "$(date) [ERROR] 启动超时，Socket 未生成" >> "$LOG_FILE"
  exit 1
}

case "${1:-status}" in
  start)  start_app ;;
  stop)
    kill_instance
    rm -f "$SOCKET_PATH" 2>/dev/null || true
    exit 0 ;;
  status) is_running && (echo "Running"; exit 0) || (echo "Stopped"; exit 3) ;;
  *)      exit 1 ;;
esac
